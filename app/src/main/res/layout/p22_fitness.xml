<?xml version="1.0" encoding="utf-8"?>
<!-- Практика 22. Дашборд фитнес-трекера: кольцо прогресса, внутри шаги, по бокам калории и км -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar_common" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- подложка кольца и само кольцо лежат друг на друге (одинаковые констрейнты) -->
            <ProgressBar
                android:id="@+id/ringBg"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="24dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/bg_ring"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ProgressBar
                android:id="@+id/ringSteps"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:max="10000"
                android:progress="7340"
                android:progressDrawable="@drawable/progress_ring"
                app:layout_constraintBottom_toBottomOf="@id/ringBg"
                app:layout_constraintEnd_toEndOf="@id/ringBg"
                app:layout_constraintStart_toStartOf="@id/ringBg"
                app:layout_constraintTop_toTopOf="@id/ringBg" />

            <TextView
                android:id="@+id/tvStepsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/p22_fitness_text1"
                android:textColor="@color/text_primary"
                android:textSize="36sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tvStepsLabel"
                app:layout_constraintEnd_toEndOf="@id/ringBg"
                app:layout_constraintStart_toStartOf="@id/ringBg"
                app:layout_constraintTop_toTopOf="@id/ringBg"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvStepsLabel"
                style="@style/Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/p22_fitness_text2"
                app:layout_constraintBottom_toBottomOf="@id/ringBg"
                app:layout_constraintEnd_toEndOf="@id/ringBg"
                app:layout_constraintStart_toStartOf="@id/ringBg"
                app:layout_constraintTop_toBottomOf="@id/tvStepsValue" />

            <!-- слева калории, справа километры, по центру кольца по вертикали -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/p22_fitness_text3"
                android:textColor="@color/accent"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/ringBg"
                app:layout_constraintEnd_toStartOf="@id/ringBg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/ringBg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/p22_fitness_text4"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/ringBg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ringBg"
                app:layout_constraintTop_toTopOf="@id/ringBg" />

            <TextView
                style="@style/Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/p22_fitness_text5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ringBg" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>
</LinearLayout>
