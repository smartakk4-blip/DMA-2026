<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 6, задание 5: составной футер корзины (итог + кнопка оплаты).
    Подключается в корзину (практика 42) и в экран повторного заказа (практика 28).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    tools:ignore="Overdraw"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/layout_cart_footer_text1" />

        <TextView
            android:id="@+id/tvFooterTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/layout_cart_footer_text2"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnFooterPay"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="@string/layout_cart_footer_text3" />
</LinearLayout>
