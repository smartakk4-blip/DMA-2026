<?xml version="1.0" encoding="utf-8"?>
<!-- Практика 36. Видеоплеер: по тапу на видео появляются пауза, полный экран и качество -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- контейнер видео 16:9 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/p36_video_player_cd1"
                android:scaleType="centerCrop"
                android:src="@drawable/img_video" />

            <!-- слой управления: показывается/скрывается по тапу (код в Behaviors) -->
            <FrameLayout
                android:id="@+id/videoControls"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/dim_light">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_badge_red"
                    android:backgroundTint="@color/dim"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/p36_video_player_text2"
                    android:textColor="@color/white" />

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/dim"
                    android:contentDescription="@string/p36_video_player_cd3"
                    android:padding="16dp"
                    android:src="@drawable/ic_pause"
                    app:tint="@color/white" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:contentDescription="@string/p36_video_player_cd4"
                    android:padding="8dp"
                    android:src="@drawable/ic_fullscreen"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="14dp"
                    android:text="@string/p36_video_player_text5"
                    android:textColor="@color/white" />
            </FrameLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p36_video_player_text6"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/p36_video_player_text7"
            android:textColor="#B3FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/p36_video_player_text8"
            android:textColor="#80FFFFFF" />
    </LinearLayout>
</LinearLayout>
