                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/p07_track_card_text11" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Caption"
                android:layout_width="wrap_content"
