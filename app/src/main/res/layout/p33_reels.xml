<?xml version="1.0" encoding="utf-8"?>
<!-- Практика 33. Reels/Shorts: полноэкранное видео, справа колонка кнопок поверх -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/p33_reels_cd1"
        android:scaleType="centerCrop"
        android:src="@drawable/img_reels" />

    <!-- градиент снизу, чтобы белый текст читался на светлом кадре -->
    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_gradient" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:text="@string/p33_reels_text2"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <!-- вертикальная колонка кнопок справа -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="110dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:contentDescription="@string/p33_reels_cd3"
            android:padding="6dp"
            android:src="@drawable/ic_favorite"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p33_reels_text4"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:contentDescription="@string/p33_reels_cd5"
            android:padding="6dp"
            android:src="@drawable/ic_comment"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p33_reels_text6"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:contentDescription="@string/p33_reels_cd7"
            android:padding="6dp"
            android:src="@drawable/ic_share"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p33_reels_text8"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:contentDescription="@string/p33_reels_cd9"
            android:padding="6dp"
            android:src="@drawable/ic_volume"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p33_reels_text10"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="80dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/p33_reels_cd11"
                android:scaleType="centerCrop"
                android:src="@drawable/img_avatar4"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/reels_author"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/p33_reels_text12"
            android:textColor="@color/white" />
    </LinearLayout>
</FrameLayout>
