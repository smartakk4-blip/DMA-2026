<?xml version="1.0" encoding="utf-8"?>
<!-- Тема 5, задание 2: длинный текст в ScrollView, кнопка "Принять" вне области скролла -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar_common" />

    <!-- weight=1: скролл занимает всё, что осталось между шапкой и кнопкой -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:padding="@dimen/screen_padding"
            android:text="@string/license_text" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="@dimen/screen_padding"
        android:text="@string/topic5_license_text1" />
</LinearLayout>
