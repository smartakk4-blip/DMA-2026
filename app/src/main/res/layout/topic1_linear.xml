<?xml version="1.0" encoding="utf-8"?>
<!-- Тема 1. LinearLayout: линейное распределение и веса -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar_common" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- 1. Ряд пин-клавиатуры: три круглые кнопки с весом 1 -->
            <TextView style="@style/SectionTitle" android:text="@string/topic1_linear_text1" />

            <LinearLayout
                android:baselineAligned="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Button
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="@string/topic1_linear_text2"
                        android:textSize="26sp"
                        app:cornerRadius="36dp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Button
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="@string/topic1_linear_text3"
                        android:textSize="26sp"
                        app:cornerRadius="36dp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Button
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="@string/topic1_linear_text4"
                        android:textSize="26sp"
                        app:cornerRadius="36dp" />
                </FrameLayout>
            </LinearLayout>

            <!-- 2. Сплит 50/50: две половины с одинаковым весом -->
            <TextView style="@style/SectionTitle" android:text="@string/topic1_linear_text5" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/primary"
                    android:gravity="center"
                    android:text="@string/topic1_linear_text6"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/topic1_linear_text7"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- 3. Поле поиска: поле забирает всё место (weight), лупа фиксированная 48dp -->
            <TextView style="@style/SectionTitle" android:text="@string/topic1_linear_text8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp">

                <EditText
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/topic1_linear_hint9"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <ImageButton
                    style="@style/IconButton"
                    android:contentDescription="@string/topic1_linear_cd10"
                    android:src="@drawable/ic_search" />
            </LinearLayout>

            <!-- 4. layout_gravity: заголовок по центру, подзаголовок справа -->
            <TextView style="@style/SectionTitle" android:text="@string/topic1_linear_text11" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_light"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/topic1_linear_text12" />

                <TextView
                    style="@style/Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/topic1_linear_text13" />
            </LinearLayout>

            <!-- 5. Форма входа с разделителем 1dp -->
            <TextView style="@style/SectionTitle" android:text="@string/topic1_linear_text14" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@null"
                    android:hint="@string/topic1_linear_hint15"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@null"
                    android:hint="@string/topic1_linear_hint16"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
