                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <TextView style="@style/SectionTitle" android:text="@string/topic5_scroll_text10" />

            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/topic5_scroll_text11" />

            <!-- 5. Письменный ответ -->
            <TextView style="@style/SectionTitle" android:text="@string/topic5_scroll_text12" />

            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_light"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:text="@string/nested_scroll_answer" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
