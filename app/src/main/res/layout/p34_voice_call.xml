<?xml version="1.0" encoding="utf-8"?>
<!-- Практика 34. Экран голосового вызова: размытый фон, статус, аватар, кнопки сброса и ответа -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- фон: фото звонящего на весь экран, размывается в коде (RenderEffect, Android 12+) -->
    <ImageView
        android:id="@+id/ivCallBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/p34_voice_call_cd1"
        android:scaleType="centerCrop"
        android:src="@drawable/img_avatar2" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="80dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p34_voice_call_text2"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/p34_voice_call_text3"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p34_voice_call_text4"
            android:textColor="#CCFFFFFF" />
    </LinearLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:contentDescription="@string/p34_voice_call_cd5"
        android:scaleType="centerCrop"
        android:src="@drawable/img_avatar2"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:strokeColor="#80FFFFFF"
        app:strokeWidth="3dp" />

    <!-- две круглые кнопки внизу -->
    <LinearLayout
        android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="64dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageButton
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/red"
                android:contentDescription="@string/p34_voice_call_cd6"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_call_end"
                app:tint="@color/white" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageButton
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#43A047"
                android:contentDescription="@string/p34_voice_call_cd7"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_call"
                app:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
