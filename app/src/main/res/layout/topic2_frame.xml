<?xml version="1.0" encoding="utf-8"?>
<!-- Тема 2. FrameLayout: наложение слоев (нижний в XML рисуется поверх верхнего) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar_common" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- 1. Аватар с бейджем "онлайн" в правом нижнем углу -->
            <TextView style="@style/SectionTitle" android:text="@string/topic2_frame_text1" />

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/topic2_frame_cd2"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_avatar1"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_online_dot" />
            </FrameLayout>

            <!-- 2. Кнопка с оверлеем загрузки: ProgressBar лежит поверх кнопки -->
            <TextView style="@style/SectionTitle" android:text="@string/topic2_frame_text3" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnSubmitOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/topic2_frame_text4" />

                <!-- elevation больше, чем у кнопки, иначе кнопка (у нее своя тень) перекроет спиннер -->
                <ProgressBar
                    android:id="@+id/progressOverlay"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:elevation="8dp"
                    android:indeterminateTint="@color/primary"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 3. FAB в правом нижнем углу поверх текста, отступ 24dp -->
            <TextView style="@style/SectionTitle" android:text="@string/topic2_frame_text5" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_rounded_light">

                <TextView
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    android:text="@string/topic2_frame_text6" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="24dp"
                    android:contentDescription="@string/topic2_frame_cd7"
                    android:src="@drawable/ic_add" />
            </FrameLayout>

            <!-- 4. Пустой контейнер под фрагмент под шапкой -->
            <TextView style="@style/SectionTitle" android:text="@string/topic2_frame_text8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@color/primary_light"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:text="@string/topic2_frame_text9"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />

                <!-- Сюда FragmentManager добавит фрагмент: занимает всё место под шапкой -->
                <FrameLayout
                    android:id="@+id/fragmentContainerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        style="@style/Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/fragment_placeholder" />
                </FrameLayout>
            </LinearLayout>

            <!-- 5. Видео-превью с иконкой Play по центру -->
            <TextView style="@style/SectionTitle" android:text="@string/topic2_frame_text10" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/topic2_frame_cd11"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_video" />

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:alpha="0.85"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="@string/topic2_frame_cd12"
                    android:padding="14dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_badge_red"
                    android:backgroundTint="@color/dim"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/topic2_frame_text13"
                    android:textColor="@color/white" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
