<?xml version="1.0" encoding="utf-8"?>
<!-- Практика 17. Ввод данных карты: лицевая сторона и обратная со смещенным полем CVC -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar_common" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- обратная сторона: сдвинута вправо и вниз, лежит ПОД лицевой (объявлена раньше) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardBack"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="110dp"
                android:layout_marginTop="60dp"
                android:background="@drawable/bg_bank_card_back"
                app:layout_constraintDimensionRatio="85:54"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <View
                    android:id="@+id/magStripe"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:background="#212121"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/p17_card_input_text1"
                    android:textColor="#CCFFFFFF"
                    app:layout_constraintBottom_toBottomOf="@id/etCvc"
                    app:layout_constraintEnd_toStartOf="@id/etCvc"
                    app:layout_constraintTop_toTopOf="@id/etCvc" />

                <EditText
                    android:id="@+id/etCvc"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_field"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/p17_card_input_hint2"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:maxLength="3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/magStripe" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- лицевая сторона -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardFront"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="110dp"
                android:background="@drawable/bg_bank_card"
                android:elevation="6dp"
                android:padding="16dp"
                app:layout_constraintDimensionRatio="85:54"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvCardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/p17_card_input_text3"
                    android:textColor="#CCFFFFFF"
                    app:layout_constraintBottom_toTopOf="@id/etCardNumber"
                    app:layout_constraintStart_toStartOf="parent" />

                <EditText
                    android:id="@+id/etCardNumber"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_field"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/p17_card_input_hint4"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintBottom_toTopOf="@id/etCardDate"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.55" />

                <EditText
                    android:id="@+id/etCardDate"
                    android:layout_width="96dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_field"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/p17_card_input_hint5"
                    android:importantForAutofill="no"
                    android:inputType="date"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/etCardNumber" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="@string/p17_card_input_text6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardBack" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>
</LinearLayout>
