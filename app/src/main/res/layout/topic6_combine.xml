<?xml version="1.0" encoding="utf-8"?>
<!-- Тема 6. Комбинирование разметок: include, merge, ViewStub -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 1. Единая шапка: тот же toolbar_common подключен во ВСЕ обычные экраны приложения -->
    <include layout="@layout/toolbar_common" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView style="@style/SectionTitle" android:text="@string/topic6_combine_text1" />

            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/topic6_combine_text2" />

            <!-- 2. Карточка из merge: ImageView и TextView становятся прямыми детьми этого LinearLayout -->
            <TextView style="@style/SectionTitle" android:text="@string/topic6_combine_text3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:padding="12dp">

                <include layout="@layout/view_icon_card" />
            </LinearLayout>

            <!-- 3. ViewStub: экран "Нет интернета" не создается, пока не нажата кнопка -->
            <TextView style="@style/SectionTitle" android:text="@string/topic6_combine_text4" />

            <Button
                android:id="@+id/btnShowNoInternet"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/topic6_combine_text5" />

            <ViewStub
                android:id="@+id/stubNoInternet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inflatedId="@+id/noInternetView"
                android:layout="@layout/layout_no_internet" />

            <!-- 4. Один макет дважды с переопределенными width и margin -->
            <TextView style="@style/SectionTitle" android:text="@string/topic6_combine_text6" />

            <include
                layout="@layout/view_stat_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                layout="@layout/view_stat_tile"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_margin="24dp" />

            <TextView style="@style/SectionTitle" android:text="@string/topic6_combine_text7" />

            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/topic6_combine_text8" />
        </LinearLayout>
    </ScrollView>

    <!-- 5. Футер корзины -->
    <include layout="@layout/layout_cart_footer" />
</LinearLayout>
